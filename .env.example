# Google Analytics 4 measurement ID (Admin > Data Streams > Web)
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification value (Settings > Ownership verification > HTML tag > content="...")
NEXT_PUBLIC_GSC_VERIFICATION=

# Resend API key for contact form emails (https://resend.com/api-keys)
RESEND_API_KEY=

# Override the recipient address (useful during Resend sandbox — set to your Resend account email;
# once a domain is verified, remove this and emails will go to the NGO address in site.ts)
RESEND_TO_EMAIL=
